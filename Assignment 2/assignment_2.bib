	pages = {2498--2504},
	file = {Texte intégral:/Users/katherineleung/Zotero/storage/8FFTL5NC/Shannon et al. - 2003 - Cytoscape a software environment for integrated models of biomolecular interaction networks.pdf:application/pdf},
}

