	file = {Full Text PDF:/Users/katherineleung/Zotero/storage/LM9TQ6DH/Liberzon et al. - 2015 - The Molecular Signatures Database (MSigDB) hallmark gene set collection.pdf:application/pdf},
}

@article{li_epithelial-mesenchymal_2016,
